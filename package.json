{
  "name": "sift-mail",
  "private": true,
  "description": "Sift Mail multi-account desktop email client",
  "version": "0.7.1",
  "type": "module",
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "tsx core/server.ts",
    "dev:desktop": "npm run build && electron .",
    "dev:mobile": "npm run build:web && node scripts/run-capacitor.cjs run android",
    "build": "npm run clean && npm run build:web && npm run build:server",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:server": "esbuild core/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('server.js',{force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node tests/security-runner.cjs && node --test tests/mail-folders.cjs tests/mail-view-guard.cjs tests/ai-privacy.cjs tests/plugin-system.cjs",
    "test:ui": "node tests/ui-smoke.cjs",
    "cap:sync": "node scripts/run-capacitor.cjs sync",
    "cap:build": "npm run build:mobile",
    "build:mobile": "npm run build:web && node scripts/run-capacitor.cjs sync",
    "build:android": "npm run build:web && node scripts/run-capacitor.cjs build android",
    "build:ios": "npm run build:web && node scripts/run-capacitor.cjs build ios",
    "mobile:add:android": "node scripts/run-capacitor.cjs add android",
    "mobile:add:ios": "node scripts/run-capacitor.cjs add ios",
    "build:desktop": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@langchain/core": "^1.2.11",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "imapflow": "^2.0.2",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.28",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "telegraf": "^4.16.3",
    "vite": "^6.2.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.siftmail.desktop",
    "productName": "Sift Mail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Sift-Mail-Setup-${version}.${ext}",
      "icon": "public/pwa-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sift Mail"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Sift-Mail-${version}.${ext}",
      "category": "Office",
      "icon": "public/pwa-512x512.png"
    }
  }
}
