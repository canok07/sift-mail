# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Frontend Base URL for API requests.
# Leave empty for relative paths (/api/...) or provide custom URL (e.g., http://192.168.1.100:3000)
VITE_API_URL=

# Direct IMAP Account Credentials
# Used by /api/emails/sync to retrieve incoming mailbox history
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

# CORS Configuration
# Comma-separated list of allowed origins or domains (e.g., http://192.168.1.100:3000,https://siftmail.app)
CORS_ORIGIN=
