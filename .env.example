# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Frontend Base URL for API requests.
# Leave empty for relative paths (/api/...) or provide custom URL (e.g., http://192.168.1.100:3000)
VITE_API_URL=

# Direct IMAP Account Credentials
# Used by /api/emails/sync to retrieve incoming mailbox history
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

# CORS Configuration
# Comma-separated list of allowed origins or domains (e.g., http://192.168.1.100:3000,https://siftmail.app)
CORS_ORIGIN=

# Network & Host Binding Security
# Default bind host is 127.0.0.1 (localhost only). Set ENABLE_LAN_ACCESS=true to allow LAN traffic (0.0.0.0).
HOST=127.0.0.1
ENABLE_LAN_ACCESS=false

# API Token Protection
# Optional pre-shared key for /api/ endpoints. If left empty, a secure in-memory session token is generated at boot.
SIFT_API_TOKEN=

# TLS Certificate Validation (Default: strict / true)
# Set to true only in private development environments with self-signed certificates.
ALLOW_INSECURE_TLS=false

# Microsoft Outlook / Hotmail OAuth (required for Modern Auth)
# Create a Microsoft Entra App Registration and add this redirect URI:
# http://localhost:3000/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
